                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('error code matches', function () {",
                  "    pm.expect(pm.response.json().error).to.eql('validation_error');",
