{
  "info": {
    "_postman_id": "b62a711a-35ed-4f4a-b7e8-495e8bf6f1b4",
    "name": "Community Events Hub API",
    "description": "Runnable test suite for the Community Events Hub backend (see solution/backend/docs/API.md for the full reference). Mirrors the manual verification checklist in PLAN-backend.md.\n\nRun 'Auth > Login (admin)' and 'Auth > Login (attendee)' first (or run the whole collection top-to-bottom) to populate the admin_token/attendee_token environment variables every other request depends on.\n\nRun `poetry run flask db-setup` fresh (delete instance/ and uploads/ first) before running this collection end-to-end -- registration state persists in the DB across runs, so a second run without resetting will hit 'already_registered' where the first run expected success.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{admin_email}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('returns access_token and admin user', function () {",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "    pm.expect(body.user.is_admin).to.eql(true);",
                  "});",
                  "pm.environment.set('admin_token', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (attendee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
