              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('is a non-empty array, sorted by start ascending, with remaining_spots', function () {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    for (const ev of body) {",
                  "        pm.expect(ev.remaining_spots).to.be.a('number');",
                  "        pm.expect(ev).to.not.have.property('attendees');",
                  "    }",
                  "    const starts = body.map(e => new Date(e.start).getTime());",
                  "    const sorted = [...starts].sort((a, b) => a - b);",
                  "    pm.expect(starts).to.eql(sorted);",
                  "});"
                ]
              }
            }
          ]
        },
