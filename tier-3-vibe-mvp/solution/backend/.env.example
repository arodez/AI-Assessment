# Copy to .env (git-ignored) and adjust only if you need to override the defaults.
# Both DATABASE_URL and UPLOAD_FOLDER default to paths computed relative to
# solution/backend/ in app/config.py — leave them commented out unless you
# specifically need to point at a different location.

# DATABASE_URL=sqlite:////absolute/path/to/instance/app.db
# UPLOAD_FOLDER=/absolute/path/to/uploads/events

FLASK_APP=app:create_app
FLASK_ENV=development

# --- Auth ---
# Safe to leave as-is for local dev. MUST be overridden to a real secret
# outside local dev — never commit a real value here.
JWT_SECRET_KEY=dev-only-change-me-not-a-real-secret-32chars
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# --- CORS --- (comma-separated list of allowed origins for the React frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Upload guardrails --- (defense in depth ahead of the app-level 5MB image check)
MAX_CONTENT_LENGTH_MB=6
