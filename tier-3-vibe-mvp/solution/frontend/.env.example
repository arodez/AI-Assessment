# Copy to .env (git-ignored) and adjust only if the backend runs somewhere
# other than the default local dev port.
#
# Must be prefixed with VITE_ for Vite to expose it to client code
# (import.meta.env.VITE_API_BASE_URL) — any other prefix is silently
# unavailable in the browser bundle.
VITE_API_BASE_URL=http://localhost:5000
